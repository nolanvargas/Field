	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:stop": "node scripts/dev-stop.mjs",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"test": "vitest run",
		"test:watch": "vitest",
		"adb:virtual": "node scripts/adb-target.mjs virtual",
		"adb:physical": "node scripts/adb-target.mjs physical",
		"cap:live": "node scripts/cap-live.mjs",
		"cap:sync": "npm run build && npx cap sync",
		"cap:android": "npm run cap:sync && npx cap open android",
		"cap:ios": "npm run cap:sync && npx cap open ios",
		"android:keystore": "node scripts/android-keystore.mjs",
		"apk:serve": "node scripts/apk-serve.mjs",
		"db:schema": "node scripts/apply-schema.mjs",
		"db:import-contacts": "node scripts/import-contacts.mjs",
		"db:import-addresses": "node scripts/import-addresses.mjs",
		"db:geocode-addresses": "node scripts/geocode-addresses.mjs",
		"db:import-users": "node scripts/import-users.mjs",
		"db:seed-dev-data": "node scripts/seed-dev-data.mjs",
		"db:seed-dev-tasks": "node scripts/seed-dev-tasks.mjs",
		"db:seed-print-templates": "node scripts/seed-print-templates.mjs",
		"db:seed": "node scripts/seed-dev-data.mjs && node scripts/seed-dev-tasks.mjs",
		"db:reset": "node scripts/reset-dev-db.mjs",
		"db:reset-org-config": "node scripts/reset-org-config.mjs",
		"db:wipe-tasks": "node scripts/wipe-tasks.mjs",
		"db:purge-cancelled": "node scripts/purge-cancelled-tasks.mjs",
		"email:test": "node scripts/send-test-email.mjs",
		"import:sheet-spec": "node scripts/print-import-sheet-spec.mjs"
