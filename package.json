		"leaflet": "^1.9.4",
		"lucide-react": "^1.24.0",
		"pdfjs-dist": "^6.1.200",
		"pdfkit": "^0.19.1",
		"pg": "^8.22.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-leaflet": "^5.0.0",
		"react-router-dom": "^7.18.1",
		"sharp": "^0.35.3",
		"sonner": "^2.0.8",
		"use-pull-to-refresh": "^3.0.3"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.8",
		"@types/dompurify": "^3.0.5",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^24.13.3",
		"@types/qrcode": "^1.5.6",
