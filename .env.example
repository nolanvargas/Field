# Copy to .env and adjust. Never commit .env.
# The Node API loads this file on startup (Vite also loads it).

# --- Database (local default: Docker Compose on port 5433) ---
# docker compose up -d
# DATABASE_URL=postgresql://field:field@localhost:5433/field
#
# Or omit DATABASE_URL — defaults to localhost:5433 / field / field (see scripts/lib/db-config.mjs).

# --- API ---
# API_PORT=3000

# --- Branding (web reads VITE_*; API reads COMPANY_*) ---
# Local dev org: Sandbocks — see docs/official-orgs.md
COMPANY_NAME=Sandbocks
COMPANY_SUPPORT_EMAIL=support@sandbocks.example
VITE_COMPANY_NAME=Sandbocks
VITE_COMPANY_SUPPORT_EMAIL=support@sandbocks.example

# --- Email (local default: log to API terminal) ---
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# EMAIL_TEST_TO=test@example.com

# Absolute origin for customer tracking links in emails (optional).
# When unset, tracking CTAs are omitted from outbound email.
# PUBLIC_APP_URL=http://localhost:5173

# --- File storage (local default: ./storage/) ---
# Optional S3 when deploying to AWS:
# AWS_REGION=us-west-1
# S3_BUCKET=

# --- Google Maps / Places (optional — address autocomplete and geocoding) ---
# GOOGLE_MAPS_API_KEY=

# --- PDF document templates ---
# JSON layouts in document-templates/*.json — see docs/document-templates.md

# --- Web auth: Microsoft Entra ID (MSAL) — web only; mobile uses QR ---
# Leave unset for local stub login (user picker).
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_API_AUDIENCE=

# --- Mobile / Capacitor (optional) ---
# Override API host for bundled native builds on a physical device:
# VITE_API_BASE=http://192.168.1.10:3000

# --- Management import: Google Sheets copy links (optional JSON) ---
# VITE_IMPORT_GOOGLE_SHEETS={"contacts":"SPREADSHEET_ID","addresses":"SPREADSHEET_ID","users":"SPREADSHEET_ID"}

# --- Android release signing (one-time; see README Mobile section) ---
# FIELD_KEYSTORE_PASSWORD=
